#!/usr/bin/env python3
"""Run the latest TeX build or reconstruct its captured output.

``texlatest build ENGINE`` starts a detached ``tectonic`` or ``latexmk`` build
and returns after scheduling it. ``texlatest log [ENGINE]`` prints captured
output for the latest matching build. Worker processes are identified via
/proc and each owns a separate process group, so replacing a build also
terminates its child processes.
"""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import BinaryIO


SCRIPT_PATH = os.path.realpath(__file__)
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
LOG_PATH = CACHE_DIR / "texlatest.log"
BACKGROUND_ENV = "TEXLATEST_BACKGROUND"
ENGINES = frozenset({"tectonic", "latexmk"})
USAGE = (
    "usage: texlatest {build {tectonic|latexmk} [options] file.tex|"
    "log [tectonic|latexmk]}"
)


def log_event(event: str, **details: object) -> None:
    """Append an event without allowing logging failures to affect builds."""
    record = {
        "timestamp": datetime.now(timezone.utc).isoformat(timespec="milliseconds"),
        "pid": os.getpid(),
        "event": event,
        **details,
    }
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as log_file:
            log_file.write(
                json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n"
            )
    except OSError:
        pass


# Options in Tectonic's stable CLI that consume the following argument.
TECTONIC_VALUE_OPTIONS = {
    "-c",
    "--chatter",
    "--color",
    "-f",
    "--format",
    "-b",
    "--bundle",
    "--outfmt",
    "--makefile-rules",
    "--pass",
    "-r",
    "--reruns",
    "--hide",
    "-o",
    "--outdir",
}

# Latexmk accepts a broad set of options. These are the options that consume a
# separate argument; = forms are handled independently by source_argument.
LATEXMK_VALUE_OPTIONS = {
    "-aux-directory",
    "-auxdir",
    "-deps-escape",
    "-deps-out",
    "-dF",
    "-e",
    "-jobname",
    "-latex",
    "-latexoption",
    "-lualatex",
    "-lualatexoption",
    "-outdir",
    "-output-directory",
    "-pdflatex",
    "-pdflatexoption",
    "-pretex",
    "-r",
    "-rdeps",
    "-rdeps-out",
    "-usepretex",
    "-view",
    "-xelatex",
    "-xelatexoption",
}


def source_argument(engine: str, arguments: list[str]) -> str | None:
    """Return the one explicit .tex positional input for an engine invocation."""
    value_options = (
        TECTONIC_VALUE_OPTIONS if engine == "tectonic" else LATEXMK_VALUE_OPTIONS
    )
    positional: list[str] = []
    index = 0

    while index < len(arguments):
        argument = arguments[index]
        if argument == "--":
            positional.extend(arguments[index + 1 :])
            break

        if argument.startswith("-") and argument != "-":
            option = argument.split("=", 1)[0]
            if engine == "latexmk":
                # Latexmk accepts either one or two leading dashes for options.
                option = "-" + option.lstrip("-")
            if option in value_options and "=" not in argument:
                index += 1
            elif engine == "tectonic":
                # Tectonic accepts both "-c value" and "-cvalue". -Z's value
                # is commonly attached (for example, -Zhelp), but may be separate.
                short_option = argument[:2]
                takes_value = short_option in value_options or short_option == "-Z"
                if len(argument) == 2 and takes_value:
                    index += 1
        else:
            positional.append(argument)
        index += 1

    tex_files = [
        argument for argument in positional if argument.lower().endswith(".tex")
    ]
    if len(tex_files) != 1:
        return None
    return tex_files[0]


def canonical_source(argument: str, cwd: str) -> str | None:
    if argument == "-":
        return None
    return os.path.realpath(os.path.join(cwd, argument))


def process_start_time(pid: int) -> int | None:
    """Return Linux's monotonic process-start tick, handling ')' in comm."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        fields = stat.rsplit(")", 1)[1].split()
        return int(fields[19])  # Field 22, after state (field 3).
    except (FileNotFoundError, IndexError, OSError, ValueError):
        return None


def process_command_line(pid: int) -> list[str] | None:
    try:
        data = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (FileNotFoundError, OSError):
        return None
    return [os.fsdecode(part) for part in data.split(b"\0") if part]


def wrapper_build(pid: int) -> tuple[str, str] | None:
    """Return a wrapper worker's engine and canonical source, if unambiguous."""
    command_line = process_command_line(pid)
    if not command_line:
        return None

    try:
        script_index = next(
            index
            for index, argument in enumerate(command_line)
            if os.path.realpath(argument) == SCRIPT_PATH
        )
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except (FileNotFoundError, OSError, StopIteration):
        return None

    arguments = command_line[script_index + 1 :]
    if len(arguments) < 2 or arguments[0] != "build" or arguments[1] not in ENGINES:
        return None
    engine = arguments[1]
    argument = source_argument(engine, arguments[2:])
    canonical = canonical_source(argument, cwd) if argument else None
    return (engine, canonical) if canonical else None


def stop_older_builds(engine: str, source: str) -> None:
    own_pid = os.getpid()
    own_start = process_start_time(own_pid)

    for name in os.listdir("/proc"):
        if not name.isdecimal():
            continue
        pid = int(name)
        if pid == own_pid or wrapper_build(pid) != (engine, source):
            continue

        # A simultaneous launch may see us. Only the newer process replaces an
        # older one; PID is a deterministic tie-breaker for same-clock-tick starts.
        started = process_start_time(pid)
        if (
            started is None
            or own_start is None
            or (started, pid) >= (own_start, own_pid)
        ):
            continue

        try:
            # We only signal groups created by this wrapper. This prevents an
            # accidental match from ever terminating an editor or shell group.
            if os.getpgid(pid) != pid:
                log_event(
                    "replacement_skipped",
                    engine=engine,
                    source=source,
                    old_pid=pid,
                    reason="unexpected_process_group",
                )
                continue
            log_event(
                "replacement_requested",
                engine=engine,
                source=source,
                old_pid=pid,
                signal="SIGTERM",
            )
            os.killpg(pid, signal.SIGTERM)
            time.sleep(0.05)
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                log_event(
                    "replacement_completed",
                    engine=engine,
                    source=source,
                    old_pid=pid,
                    outcome="stopped_after_SIGTERM",
                )
            else:
                log_event(
                    "replacement_completed",
                    engine=engine,
                    source=source,
                    old_pid=pid,
                    outcome="SIGKILL_sent",
                )
        except ProcessLookupError:
            log_event(
                "replacement_skipped",
                engine=engine,
                source=source,
                old_pid=pid,
                reason="already_exited",
            )
        except PermissionError:
            log_event(
                "replacement_skipped",
                engine=engine,
                source=source,
                old_pid=pid,
                reason="permission_denied",
            )


def log_process_output(
    stream: str,
    pipe: BinaryIO,
    engine: str,
    source: str | None,
    process_pid: int,
) -> None:
    """Record an engine output stream without allowing it to fill its pipe."""
    try:
        for chunk in iter(pipe.readline, b""):
            log_event(
                "build_output",
                engine=engine,
                source=source,
                stream=stream,
                process_pid=process_pid,
                output=chunk.decode("utf-8", errors="replace"),
            )
    finally:
        pipe.close()


def print_latest_build_log(engine: str | None) -> int:
    """Print captured output records belonging to the latest matching build."""
    try:
        with LOG_PATH.open(encoding="utf-8") as log_file:
            records = [
                record
                for line in log_file
                if isinstance(record := _json_record(line), dict)
            ]
    except OSError as error:
        print(f"texlatest: cannot read log: {error}", file=sys.stderr)
        return 1

    latest = next(
        (
            record
            for record in reversed(records)
            if record.get("event") == "build_started"
            and (engine is None or record.get("engine") == engine)
        ),
        None,
    )
    if latest is None or not isinstance(latest.get("process_pid"), int):
        scope = f" for {engine}" if engine else ""
        print(f"texlatest: no build log available{scope}", file=sys.stderr)
        return 1

    process_pid = latest["process_pid"]
    build_engine = latest.get("engine")
    for record in records:
        output = record.get("output")
        if (
            record.get("event") == "build_output"
            and record.get("process_pid") == process_pid
            and record.get("engine") == build_engine
            and isinstance(output, str)
        ):
            sys.stdout.write(output)
    return 0


def _json_record(line: str) -> dict[str, object] | None:
    try:
        value = json.loads(line)
    except json.JSONDecodeError:
        return None
    return value if isinstance(value, dict) else None


def start_background_worker() -> int:
    """Start a detached worker without retaining any caller file descriptors."""
    environment = os.environ.copy()
    environment[BACKGROUND_ENV] = "1"
    try:
        worker_pid = os.fork()
    except OSError as error:
        print(f"texlatest: cannot start background worker: {error}", file=sys.stderr)
        log_event("background_start_failed", error=str(error))
        return 1

    if worker_pid:
        log_event("background_started", worker_pid=worker_pid)
        return 0

    try:
        os.setsid()
        null_fd = os.open(os.devnull, os.O_RDWR)
        for descriptor in (0, 1, 2):
            os.dup2(null_fd, descriptor)
        if null_fd > 2:
            os.close(null_fd)
        os.execve(
            sys.executable,
            [sys.executable, SCRIPT_PATH, *sys.argv[1:]],
            environment,
        )
    except OSError as error:
        log_event("background_worker_failed", error=str(error))
        os._exit(1)


def main() -> int:
    if len(sys.argv) < 2:
        print(USAGE, file=sys.stderr)
        return 2

    command = sys.argv[1]
    if command == "log":
        if len(sys.argv) > 3 or (len(sys.argv) == 3 and sys.argv[2] not in ENGINES):
            print("usage: texlatest log [tectonic|latexmk]", file=sys.stderr)
            return 2
        return print_latest_build_log(sys.argv[2] if len(sys.argv) == 3 else None)
    if command != "build" or len(sys.argv) < 3 or sys.argv[2] not in ENGINES:
        print(USAGE, file=sys.stderr)
        return 2

    engine = sys.argv[2]
    engine_arguments = sys.argv[3:]
    source = source_argument(engine, engine_arguments)
    canonical = canonical_source(source, os.getcwd()) if source else None
    log_event(
        "start",
        engine=engine,
        source=canonical,
        cwd=os.getcwd(),
        arguments=engine_arguments,
    )

    if os.environ.get(BACKGROUND_ENV) != "1":
        return start_background_worker()

    try:
        # The launcher creates the worker's session and process group. Retain
        # the fallback for a worker started manually with the marker set.
        if os.getpgrp() != os.getpid():
            os.setpgrp()
    except OSError as error:
        log_event(
            "end",
            engine=engine,
            source=canonical,
            outcome="failure",
            reason="process_group_error",
            error=str(error),
        )
        return 1

    if canonical:
        stop_older_builds(engine, canonical)
    else:
        log_event(
            "replacement_skipped", engine=engine, reason="no_unique_tex_source"
        )

    try:
        process = subprocess.Popen(
            [engine, *engine_arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        print(f"texlatest: {engine}: command not found", file=sys.stderr)
        log_event(
            "end",
            engine=engine,
            source=canonical,
            outcome="failure",
            reason="engine_not_found",
        )
        return 127

    log_event(
        "build_started", engine=engine, source=canonical, process_pid=process.pid
    )
    output_threads = [
        threading.Thread(
            target=log_process_output,
            args=(stream, pipe, engine, canonical, process.pid),
            daemon=True,
        )
        for stream, pipe in (("stdout", process.stdout), ("stderr", process.stderr))
    ]
    for output_thread in output_threads:
        output_thread.start()

    def stopped(signum: int, _frame: object) -> None:
        log_event(
            "end",
            engine=engine,
            source=canonical,
            process_pid=process.pid,
            outcome="aborted",
            signal=signal.Signals(signum).name,
        )
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, stopped)
    signal.signal(signal.SIGINT, stopped)
    return_code = process.wait()
    for output_thread in output_threads:
        output_thread.join()
    log_event(
        "end",
        engine=engine,
        source=canonical,
        process_pid=process.pid,
        outcome="success" if return_code == 0 else "failure",
        return_code=return_code,
    )
    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
