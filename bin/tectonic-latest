#!/usr/bin/env python3
"""Run the latest tectonic build or reconstruct its captured output.

``tectonic-latest build`` starts a detached build and returns after scheduling
it. ``tectonic-latest log`` prints the captured output of the latest build.
Worker processes are identified via /proc and each one owns a separate process
group, so replacing a build also terminates its tectonic child process.
"""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import BinaryIO


SCRIPT_PATH = os.path.realpath(__file__)
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
LOG_PATH = CACHE_DIR / "tectonic-latest.log"
BACKGROUND_ENV = "TECTONIC_LATEST_BACKGROUND"
USAGE = "usage: tectonic-latest {build [tectonic options] file.tex|log}"


def log_event(event: str, **details: object) -> None:
    """Append an event without allowing logging failures to affect builds."""
    record = {
        "timestamp": datetime.now(timezone.utc).isoformat(timespec="milliseconds"),
        "pid": os.getpid(),
        "event": event,
        **details,
    }
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as log_file:
            log_file.write(
                json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n"
            )
    except OSError:
        pass


# Options in tectonic's stable CLI that consume the following argument. Keeping
# this list lets us distinguish their values from the one positional input.
VALUE_OPTIONS = {
    "-c",
    "--chatter",
    "--color",
    "-f",
    "--format",
    "-b",
    "--bundle",
    "--outfmt",
    "--makefile-rules",
    "--pass",
    "-r",
    "--reruns",
    "--hide",
    "-o",
    "--outdir",
}


def source_argument(arguments: list[str]) -> str | None:
    """Return tectonic's .tex positional argument, if this is a file build."""
    positional: list[str] = []
    index = 0

    while index < len(arguments):
        argument = arguments[index]
        if argument == "--":
            positional.extend(arguments[index + 1 :])
            break

        if argument.startswith("--"):
            option = argument.split("=", 1)[0]
            if option in VALUE_OPTIONS and "=" not in argument:
                index += 1
            # Unknown options are forwarded untouched. Tectonic will report
            # them; treating them as valueless is the least invasive choice.
        elif argument.startswith("-") and argument != "-":
            # Tectonic accepts both "-c value" and "-cvalue". -Z's value
            # is commonly attached (for example, -Zhelp), but may be separate.
            short_option = argument[:2]
            takes_value = short_option in VALUE_OPTIONS or short_option == "-Z"
            if len(argument) == 2 and takes_value:
                index += 1
        else:
            positional.append(argument)
        index += 1

    tex_files = [
        argument for argument in positional if argument.lower().endswith(".tex")
    ]
    if len(tex_files) != 1:
        return None
    return tex_files[0]


def canonical_source(argument: str, cwd: str) -> str | None:
    if argument == "-":
        return None
    return os.path.realpath(os.path.join(cwd, argument))


def process_start_time(pid: int) -> int | None:
    """Return Linux's monotonic process-start tick, handling ')' in comm."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        fields = stat.rsplit(")", 1)[1].split()
        return int(fields[19])  # Field 22, after state (field 3).
    except (FileNotFoundError, IndexError, OSError, ValueError):
        return None


def process_command_line(pid: int) -> list[str] | None:
    try:
        data = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (FileNotFoundError, OSError):
        return None
    return [os.fsdecode(part) for part in data.split(b"\0") if part]


def wrapper_source(pid: int) -> str | None:
    command_line = process_command_line(pid)
    if not command_line:
        return None

    try:
        script_index = next(
            index
            for index, argument in enumerate(command_line)
            if os.path.realpath(argument) == SCRIPT_PATH
        )
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except (FileNotFoundError, OSError, StopIteration):
        return None

    arguments = command_line[script_index + 1 :]
    if arguments[:1] == ["build"]:
        arguments = arguments[1:]
    argument = source_argument(arguments)
    return canonical_source(argument, cwd) if argument else None


def stop_older_builds(source: str) -> None:
    own_pid = os.getpid()
    own_start = process_start_time(own_pid)

    for name in os.listdir("/proc"):
        if not name.isdecimal():
            continue
        pid = int(name)
        if pid == own_pid or wrapper_source(pid) != source:
            continue

        # A simultaneous launch may see us. Only the newer process replaces an
        # older one; PID is a deterministic tie-breaker for same-clock-tick starts.
        started = process_start_time(pid)
        if (
            started is None
            or own_start is None
            or (started, pid) >= (own_start, own_pid)
        ):
            continue

        try:
            # We only signal groups created by this wrapper. This prevents an
            # accidental match from ever terminating an editor or shell group.
            if os.getpgid(pid) != pid:
                log_event(
                    "replacement_skipped",
                    source=source,
                    old_pid=pid,
                    reason="unexpected_process_group",
                )
                continue
            log_event(
                "replacement_requested", source=source, old_pid=pid, signal="SIGTERM"
            )
            os.killpg(pid, signal.SIGTERM)
            time.sleep(0.05)
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                log_event(
                    "replacement_completed",
                    source=source,
                    old_pid=pid,
                    outcome="stopped_after_SIGTERM",
                )
            else:
                log_event(
                    "replacement_completed",
                    source=source,
                    old_pid=pid,
                    outcome="SIGKILL_sent",
                )
        except ProcessLookupError:
            log_event(
                "replacement_skipped",
                source=source,
                old_pid=pid,
                reason="already_exited",
            )
        except PermissionError:
            # Another user's process cannot be a build we can safely replace.
            log_event(
                "replacement_skipped",
                source=source,
                old_pid=pid,
                reason="permission_denied",
            )


def log_tectonic_output(
    stream: str,
    pipe: BinaryIO,
    source: str | None,
    tectonic_pid: int,
) -> None:
    """Record a tectonic output stream without allowing it to fill its pipe."""
    try:
        for chunk in iter(pipe.readline, b""):
            log_event(
                "tectonic_output",
                source=source,
                stream=stream,
                tectonic_pid=tectonic_pid,
                output=chunk.decode("utf-8", errors="replace"),
            )
    finally:
        pipe.close()


def print_latest_build_log() -> int:
    """Print captured output records belonging to the most recent build."""
    try:
        with LOG_PATH.open(encoding="utf-8") as log_file:
            records = [
                record
                for line in log_file
                if isinstance(
                    record := _json_record(line),
                    dict,
                )
            ]
    except OSError as error:
        print(f"tectonic-latest: cannot read log: {error}", file=sys.stderr)
        return 1

    latest_pid = next(
        (
            record.get("tectonic_pid")
            for record in reversed(records)
            if record.get("event") == "tectonic_started"
        ),
        None,
    )
    if not isinstance(latest_pid, int):
        print("tectonic-latest: no build log available", file=sys.stderr)
        return 1

    for record in records:
        output = record.get("output")
        if (
            record.get("event") == "tectonic_output"
            and record.get("tectonic_pid") == latest_pid
            and isinstance(output, str)
        ):
            sys.stdout.write(output)
    return 0


def _json_record(line: str) -> dict[str, object] | None:
    try:
        value = json.loads(line)
    except json.JSONDecodeError:
        return None
    return value if isinstance(value, dict) else None


def start_background_worker() -> int:
    """Start a detached worker without retaining any caller file descriptors."""
    environment = os.environ.copy()
    environment[BACKGROUND_ENV] = "1"
    try:
        worker_pid = os.fork()
    except OSError as error:
        print(
            f"tectonic-latest: cannot start background worker: {error}",
            file=sys.stderr,
        )
        log_event("background_start_failed", error=str(error))
        return 1

    if worker_pid:
        log_event("background_started", worker_pid=worker_pid)
        return 0

    try:
        os.setsid()
        null_fd = os.open(os.devnull, os.O_RDWR)
        for descriptor in (0, 1, 2):
            os.dup2(null_fd, descriptor)
        if null_fd > 2:
            os.close(null_fd)
        os.execve(
            sys.executable,
            [sys.executable, SCRIPT_PATH, *sys.argv[1:]],
            environment,
        )
    except OSError as error:
        log_event("background_worker_failed", error=str(error))
        os._exit(1)


def main() -> int:
    if len(sys.argv) < 2:
        print(USAGE, file=sys.stderr)
        return 2

    command = sys.argv[1]
    if command == "log":
        if len(sys.argv) != 2:
            print("usage: tectonic-latest log", file=sys.stderr)
            return 2
        return print_latest_build_log()
    if command != "build":
        print(USAGE, file=sys.stderr)
        return 2

    tectonic_arguments = sys.argv[2:]
    source = source_argument(tectonic_arguments)
    canonical = canonical_source(source, os.getcwd()) if source else None
    log_event("start", source=canonical, cwd=os.getcwd(), arguments=tectonic_arguments)

    if os.environ.get(BACKGROUND_ENV) != "1":
        return start_background_worker()

    try:
        # The launcher creates the worker's session and process group. Retain
        # the fallback for a worker started manually with the marker set.
        if os.getpgrp() != os.getpid():
            os.setpgrp()
    except OSError as error:
        log_event(
            "end",
            source=canonical,
            outcome="failure",
            reason="process_group_error",
            error=str(error),
        )
        return 1

    if canonical:
        stop_older_builds(canonical)
    else:
        log_event("replacement_skipped", reason="no_unique_tex_source")

    try:
        process = subprocess.Popen(
            ["tectonic", *tectonic_arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except FileNotFoundError:
        print("tectonic-latest: tectonic: command not found", file=sys.stderr)
        log_event(
            "end", source=canonical, outcome="failure", reason="tectonic_not_found"
        )
        return 127

    log_event("tectonic_started", source=canonical, tectonic_pid=process.pid)
    output_threads = [
        threading.Thread(
            target=log_tectonic_output,
            args=(stream, pipe, canonical, process.pid),
            daemon=True,
        )
        for stream, pipe in (("stdout", process.stdout), ("stderr", process.stderr))
    ]
    for output_thread in output_threads:
        output_thread.start()

    def stopped(signum: int, _frame: object) -> None:
        log_event(
            "end",
            source=canonical,
            tectonic_pid=process.pid,
            outcome="aborted",
            signal=signal.Signals(signum).name,
        )
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, stopped)
    signal.signal(signal.SIGINT, stopped)
    return_code = process.wait()
    for output_thread in output_threads:
        output_thread.join()
    log_event(
        "end",
        source=canonical,
        tectonic_pid=process.pid,
        outcome="success" if return_code == 0 else "failure",
        return_code=return_code,
    )
    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
