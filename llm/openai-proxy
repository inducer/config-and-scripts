import asyncio
import secrets
import time
from contextlib import asynccontextmanager
from dataclasses import dataclass
from fnmatch import fnmatch
from typing import Generic, TypeAlias, TypeVar

import httpx
import typed_argparse as tap
import uvicorn
import yaml
from fastapi import FastAPI, HTTPException, Request
from fastapi.responses import JSONResponse, Response, StreamingResponse
from pydantic import BaseModel, Field, field_validator, model_validator


"""
llm-proxy: A lightweight OpenAI-compatible proxy for routing requests to
(for example) multiple vLLM backends.

This script provides a FastAPI-based proxy that:
2. Filters available models based on the client's API key.
3. Routes requests to specific vLLM backends based on the requested model.
4. Supports streaming and non-streaming responses for Chat, Completions, and Embeddings.
"""

# Upstream timeouts: fail fast when connecting, but allow long-running
# generations (the read timeout applies between chunks of a streamed
# response).
UPSTREAM_TIMEOUT = httpx.Timeout(
    connect=10.0, read=600.0, write=60.0, pool=10.0)

# Reject request bodies larger than this before reading them in full and
# forwarding them upstream (Nginx's client_max_body_size should be set to
# a similar or smaller value).
MAX_BODY_BYTES = 64 * 1024 * 1024  # 64 MiB


class Backend(BaseModel):
    base_url: str
    api_key: str | None = None

    @field_validator("base_url")
    @classmethod
    def strip_slash(cls, v: str) -> str:
        return v.rstrip("/")


class ClientConfig(BaseModel):
    allowed_models: list[str]  | None = None
    allowed_backends: list[str] | None = None


class ProxyConfig(BaseModel):
    listen_host: str = "127.0.0.1"
    listen_port: int = 8000
    backends: dict[str, Backend] = Field(min_length=1)
    client_keys: dict[str, ClientConfig]

    @model_validator(mode="after")
    def validate_allowed_backends(self):
        for client_cfg in self.client_keys.values():
            if client_cfg.allowed_backends is not None:
                for backend in client_cfg.allowed_backends:
                    if backend not in self.backends:
                        raise ValueError(f"Backend {backend} not found")
        return self


def authenticate(request: Request, config: ProxyConfig) -> ClientConfig:
    auth = request.headers.get("authorization")
    if not auth or not auth.startswith("Bearer "):
        raise HTTPException(status_code=401, detail="Missing API key")

    key = auth[len("Bearer "):].strip()
    if not key:
        raise HTTPException(status_code=401, detail="Missing API key")

    # To prevent timing attacks:
    # 1. Use secrets.compare_digest for constant-time comparison.
    # 2. Iterate through all keys to ensure the processing time is
    # independent of whether a match is found.
    # Keys are compared as UTF-8 bytes, so that an attacker-supplied
    # non-ASCII key cannot make the comparison raise.
    key_bytes = key.encode("utf-8")
    matched_config = None
    for client_key, client_cfg in config.client_keys.items():
        if secrets.compare_digest(client_key.encode("utf-8"), key_bytes):
            matched_config = client_cfg

    if matched_config is None:
        raise HTTPException(status_code=403, detail="Invalid API key")

    return matched_config


# -------------------------
# CORE PROXY LOGIC
# -------------------------

def add_auth_header(headers: dict[str, str], backend: Backend) -> dict[str, str]:
    return {
        **headers,
        **({"authorization": f"Bearer {backend.api_key}"}
            if backend.api_key is not None else {}),
    }


# Headers that must not be forwarded to the upstream backends:
# - authorization is replaced by the backend's own key
# - hop-by-hop headers (RFC 7230 section 6.1) only apply to a single
#   connection
# - host, content-length, and accept-encoding are managed by httpx
#   (accept-encoding is dropped so upstream never gzip-compresses the
#   response, which would break the passthrough)
STRIPPED_HEADERS = frozenset({
    "accept-encoding",
    "authorization",
    "connection",
    "content-length",
    "host",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "proxy-connection",
    "te",
    "trailers",
    "transfer-encoding",
    "upgrade",
    "x-real-ip",
})


def client_headers(request: Request) -> dict[str, str]:
    """Client request headers, minus anything the proxy must not forward."""
    headers = {
        key: value
        for key, value in request.headers.items()
        if key not in STRIPPED_HEADERS
    }
    # Don't trust a client-supplied client address: append/overwrite it
    # with the address of the direct connection (which is the reverse
    # proxy when deployed behind one).
    client = request.client
    if client is not None:
        prev_xff = headers.pop("x-forwarded-for", None)
        headers["x-forwarded-for"] = (
            f"{prev_xff}, {client.host}" if prev_xff else client.host)
        headers["x-real-ip"] = client.host
    return headers


async def open_upstream_stream(
    client: httpx.AsyncClient,
    backend: Backend,
    path: str,
    headers: dict[str, str],
    body: bytes,
) -> httpx.Response:
    """Send the request upstream and return the open streaming response."""
    request = client.build_request(
        "POST",
        f"{backend.base_url}{path}",
        headers=add_auth_header(headers, backend),
        content=body,
        timeout=UPSTREAM_TIMEOUT,
    )
    return await client.send(request, stream=True)


async def stream_upstream_body(resp: httpx.Response):
    try:
        async for chunk in resp.aiter_bytes():
            yield chunk
    finally:
        await resp.aclose()


def upstream_error_response(resp: httpx.Response) -> Response:
    """Forward an upstream error body, preserving its status code."""
    try:
        return JSONResponse(status_code=resp.status_code, content=resp.json())
    except ValueError:
        return Response(
            status_code=resp.status_code,
            content=resp.text,
            media_type=resp.headers.get("content-type", "text/plain"),
        )


@dataclass
class ModelDesc:
    id: str
    backend: str
    data: dict[str, object]


T = TypeVar("T")


class ValueWithTTL(Generic[T]):
    ttl: float
    data: T | None
    expires_at: float

    def __init__(self, ttl: float):
        self.ttl = ttl
        self.data = None
        self.expires_at = 0

    def get(self):
        if self.data is not None and time.time() < self.expires_at:
            return self.data
        return None

    def set(self, value: T):
        self.data = value
        self.expires_at = time.time() + self.ttl


async def list_models_for_backend(
        config: ProxyConfig,
        backend_name: str,
        client: httpx.AsyncClient
    ) -> list[ModelDesc]:
    backend = config.backends[backend_name]
    url = f"{backend.base_url}/v1/models"
    headers = add_auth_header({}, backend)

    resp = await client.get(url, headers=headers, timeout=10.0)
    if resp.status_code != 200:
        return []
    data = resp.json()
    return [ModelDesc(id=model.get("id"), backend=backend_name, data=model)
        for model in data.get("data", []) if isinstance(model.get("id"), str)]


BackendToModelList: TypeAlias = dict[str, list[ModelDesc]]


async def list_models(config: ProxyConfig):
    async with httpx.AsyncClient(http2=False) as client:
        # Fetch from all backends in parallel
        responses = await asyncio.gather(*[
            list_models_for_backend(config, be_name, client)
            for be_name in config.backends], return_exceptions=True)

    for be_name, resp in zip(config.backends, responses, strict=True):
        if not isinstance(resp, list):
            print(f"Exception response from {be_name}: \n{resp}")

    return {
        be_name: [
            model
            for resp in responses
            if isinstance(resp, list)
            for model in resp
            if model.backend == be_name
        ]
        for be_name in config.backends
    }


async def list_models_cached(config: ProxyConfig):
    ttl_store_name = "list_models_ttl_store"
    ttl_store: ValueWithTTL[BackendToModelList] | None = getattr(
        config, ttl_store_name, None)
    if ttl_store is None:
        ttl_store = ValueWithTTL(ttl=60)
        object.__setattr__(config, ttl_store_name, ttl_store)

    result = ttl_store.get()
    if result is None:
        result = await list_models(config)
        ttl_store.set(result)

    return result


async def model_to_backends_cached(config: ProxyConfig) -> dict[str, set[str]]:
    return {
        backend: {model.id for model in models}
        for backend, models in (await list_models_cached(config)).items()
    }


def is_model_allowed(model: str, client_cfg: ClientConfig) -> bool:
    if client_cfg.allowed_models is None:
        return True
    return any(fnmatch(model, pat) for pat in client_cfg.allowed_models)


async def pick_backend(
        config: ProxyConfig,
        client_cfg: ClientConfig,
        model: str
) -> Backend:
    backends = (
        client_cfg.allowed_backends
        if client_cfg.allowed_backends is not None
        else config.backends)

    model_to_backends = await model_to_backends_cached(config)
    for be_name in backends:
        if model in model_to_backends[be_name]:
            return config.backends[be_name]

    raise HTTPException(status_code=404, detail="Model not found")


async def generic_proxy(request: Request, config: ProxyConfig, path: str):
    client_cfg = authenticate(request, config)

    # Reject oversized bodies before reading them in full (Nginx's
    # client_max_body_size is the second line of defense for chunked
    # bodies whose content-length lies about their size).
    content_length = request.headers.get("content-length")
    if content_length is not None:
        try:
            if int(content_length) > MAX_BODY_BYTES:
                raise HTTPException(
                    status_code=413, detail="Request body too large")
        except ValueError:
            pass

    body = await request.body()
    if len(body) > MAX_BODY_BYTES:
        raise HTTPException(status_code=413, detail="Request body too large")

    try:
        json_body = await request.json()
    except Exception as e:
        raise HTTPException(status_code=400, detail="Invalid JSON") from e

    if not isinstance(json_body, dict):
        raise HTTPException(status_code=400, detail="Invalid JSON")

    model = json_body.get("model")
    if not isinstance(model, str) or not model:
        raise HTTPException(status_code=400, detail="Missing model")

    if not is_model_allowed(model, client_cfg):
        raise HTTPException(status_code=403, detail="Model not allowed")

    backend = await pick_backend(config, client_cfg, model)

    headers = client_headers(request)
    client = request.app.state.client

    if json_body.get("stream", False):
        try:
            resp = await open_upstream_stream(client, backend, path,
                                              headers, body)
        except httpx.HTTPError as e:
            raise HTTPException(
                status_code=502, detail="Backend unavailable") from e

        if resp.status_code != 200:
            await resp.aread()
            error = upstream_error_response(resp)
            await resp.aclose()
            return error

        return StreamingResponse(
            stream_upstream_body(resp),
            media_type="text/event-stream",
        )
    else:
        url = f"{backend.base_url}{path}"
        try:
            resp = await client.post(
                url,
                headers=add_auth_header(headers, backend),
                content=body,
                timeout=UPSTREAM_TIMEOUT,
            )
        except httpx.HTTPError as e:
            raise HTTPException(
                status_code=502, detail="Backend unavailable") from e

        if resp.status_code != 200:
            return upstream_error_response(resp)

        return JSONResponse(
            status_code=resp.status_code,
            content=resp.json(),
        )


class Args(tap.TypedArgs):
    config: str = tap.arg(positional=True)


def add_proxy_route(app: FastAPI, path: str, config: ProxyConfig):
    @app.post(path)
    async def gen_proxy_route(request: Request):
        return await generic_proxy(request, config, path)


def run(args: Args):
    with open(args.config) as f:
        data = yaml.safe_load(f)
    config = ProxyConfig(**data)

    @asynccontextmanager
    async def lifespan(app: FastAPI):
        async with httpx.AsyncClient(http2=False) as client:
            app.state.client = client
            yield

    # Disable the built-in docs and OpenAPI endpoints: this app is
    # exposed to the internet and must not disclose its API surface to
    # unauthenticated clients.
    app = FastAPI(
        lifespan=lifespan,
        docs_url=None,
        redoc_url=None,
        openapi_url=None,
    )

    @app.get("/v1/models")
    async def list_models_inner(request: Request):
        client_cfg = authenticate(request, config)

        all_models = await list_models_cached(config)
        filtered_models = [model
            for be_name in config.backends
            for model in all_models[be_name]
            if is_model_allowed(model.id, client_cfg)
        ]
        return {"object": "list", "data": [model.data for model in filtered_models]}

    for url in [
                "/v1/chat/completions",
                "/v1/completions",
                "/v1/embeddings",
            ]:
        add_proxy_route(app, url, config)

    # proxy_headers=False: don't let uvicorn interpret X-Forwarded-For /
    # X-Real-IP (it trusts loopback peers by default, which would apply a
    # second, implicit forwarding rewrite on top of client_headers()).
    # The proxy always appends the real TCP peer itself, which behaves the
    # same behind a reverse proxy and when run directly.
    uvicorn.run(app,
                host=config.listen_host,
                port=config.listen_port,
                proxy_headers=False)


def main():
    tap.Parser(Args).bind(run).run()


if __name__ == "__main__":
    main()
